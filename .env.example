# Application Settings
APP_NAME=Hybrid Restaurant Recommendation System (Indian Market)
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# PostgreSQL Database Settings (Async connection via asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_recommender
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_recommender

# Machine Learning & Recommendation Default Weights
DEFAULT_WEIGHT_CF=0.40
DEFAULT_WEIGHT_CONTENT=0.35
DEFAULT_WEIGHT_LOCATION=0.15
DEFAULT_WEIGHT_QUALITY=0.10

# Diversification & Spatial Settings
DEFAULT_MMR_LAMBDA=0.75
DEFAULT_MAX_DISTANCE_KM=10.0
DEFAULT_TOP_K=10

# Concurrency & Cache Backend (Phase 12 & 15)
THREAD_POOL_WORKERS=8
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
RECOMMENDATION_CACHE_ENABLED=true
RECOMMENDATION_CACHE_TTL_SECONDS=300
RECOMMENDATION_CACHE_MAX_SIZE=1000

# Streamlit Frontend Client
STREAMLIT_API_BASE_URL=http://localhost:8000

# Model Storage Paths
MODEL_STORAGE_DIR=saved_models

